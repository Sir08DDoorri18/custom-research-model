# Copy this file to .env and paste your keys after the = sign. .env is never committed (see .gitignore).
# Every key is optional: a missing key just switches off the models that need it.
# After editing, run:  python -m research doctor

# https://console.groq.com/keys
GROQ_API_KEY=

# https://console.mistral.ai/api-keys  (choose the free "Experiment" plan)
MISTRAL_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://build.nvidia.com  -> profile menu -> API Keys
NVIDIA_API_KEY=

# Optional: https://www.semanticscholar.org/product/api#api-key-form  (free; avoids shared-quota 429s)
S2_API_KEY=
